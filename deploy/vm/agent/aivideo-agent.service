[Unit]
Description=AI Video Generator Agent API
Wants=network-online.target
Requires=aivideo-mcp.service
After=network-online.target aivideo-mcp.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mcp-agent
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/mcp-agent/.env
ExecStart=/home/ubuntu/mcp-agent/start-agent.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
