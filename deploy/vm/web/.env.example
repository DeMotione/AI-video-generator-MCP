DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=video.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://video.example.com
DB_BACKEND=sqlite
STORAGE_BACKEND=local
GENERATION_BACKEND=agent
AGENT_URL=http://127.0.0.1:8100
# Copy the value from /home/ubuntu/mcp-agent/.env on the VM.
AGENT_API_TOKEN=REPLACE_WITH_THE_EXISTING_AGENT_TOKEN
AGENT_JOB_TIMEOUT_SECONDS=3600
