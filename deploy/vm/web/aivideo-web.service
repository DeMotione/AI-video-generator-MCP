[Unit]
Description=AI Video Generator website
Wants=network-online.target
After=network-online.target aivideo-agent.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/aivideo-web/AiVideoGenerator/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/aivideo-web/.env
ExecStart=/home/ubuntu/aivideo-web/AiVideoGenerator/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 60 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
